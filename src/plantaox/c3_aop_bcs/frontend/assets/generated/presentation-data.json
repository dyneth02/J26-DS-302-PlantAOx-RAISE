  "predictors": [
    {
      "id": "aopxsvm",
      "name": "AOPxSVM",
      "tier": "primary",
      "order": 1,
      "readiness": "best_first-integration_candidate",
      "status": "not_integrated",
      "rationale": "The public repository bundles the SVM, scaler, selected-feature table, and inference code; it exposes one unambiguous positive-class probability and has a reachable web form. Its main risk is reproducing the legacy Python 3.7/scikit-learn 1.0.2 joblib environment."
    },
    {
      "id": "anoxpepred",
      "name": "AnOxPePred",
      "tier": "primary",
      "order": 2,
      "readiness": "model-available_semantics-decision-needed",
      "status": "not_integrated",
      "rationale": "Public source and TensorFlow checkpoint files are available and the DTU service is reachable, but the legacy TensorFlow environment must be reproduced and the two-output FRS/Chelator model requires a frozen scalar-score choice for C3."
    },
    {
      "id": "pu_aop",
      "name": "PU-AOP (Component 2)",
      "tier": "primary",
      "order": 3,
      "readiness": "conditional_on_frozen_handoff",
      "status": "not_integrated",
      "rationale": "PU-AOP is scientifically central to the project and local source/manifests exist, but Component 2 must select the frozen model and provide the ignored checkpoint, compatible feature resources, runtime contract, and reference score before C3 integration."
    },
    {
      "id": "multi_aop",
      "name": "Multi-AOP",
      "tier": "secondary",
      "order": 4,
      "readiness": "deferred_environment-and-licence-risk",
      "status": "not_integrated",
      "rationale": "Code and checkpoints exist, but the PyTorch Geometric/RDKit/xLSTM environment, hard-coded paths, 2-30 versus 50-residue behavior, and missing repository licence create more PP1 risk than the primary candidates."
    },
    {
      "id": "aop_drl",
      "name": "AOP-DRL",
      "tier": "secondary",
      "order": 5,
      "readiness": "blocked_missing-inference-assets",
      "status": "not_integrated",
      "rationale": "The public repository lacks a trained checkpoint and complete inference package, the published endpoint is not serving AOP-DRL, and the stated non-commercial restriction requires clarification."
    }
  ],
