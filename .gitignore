src/plantaox/c2_pu/docs/Proposal Report - IT23183018.pdf

# EMBOSS (needleall, invoked by GraphPart) writes this to the CWD by default
needleall.error

# Peptipedia v2.0 Zenodo dump (281MB, DOI 10.5281/zenodo.21488992) -- too
# large for a normal git push (GitHub's 100MB-per-file limit, no Git LFS
# configured here), same "don't commit large binary artifacts" rule already
# applied to ESM-2's pretrained weights. Its SHA-256/MD5 and DOI are recorded
# in c2_build_report.json and fr2_c2_provenance.jsonl so anyone can
# re-download the byte-identical file and reproduce C2 deterministically.
data/raw/c2_pu/Peptipedia/*.sql.gz

# Bucket 2.3 (C3) ESM-2 embedding caches -- raw vectors for ~26k sequences,
# same "don't commit large embedding arrays" rule as model weights. Fully
# regeneratable from stage_c3's cached raw inputs + the frozen embedding
# spec (common/embeddings.py); SHA-256/shape recorded in c3_build_report.json
# and fr2_c3_provenance.jsonl instead.
data/interim/c2_pu/c3_positive_embeddings.npz
data/interim/c2_pu/c3_candidate_embeddings.npz

# Scratch I/O for the WSL esm2_cli.py subprocess call above -- overwritten
# every run, and the candidates variant balloons to several MB of
# per-peptide scalar fingerprints with no information not already captured
# (more usefully) in c3_build_report.json and fr2_c3_provenance.jsonl.
data/interim/c2_pu/c3_embed_input.json
data/interim/c2_pu/c3_embed_positives_report.json
data/interim/c2_pu/c3_embed_candidates_report.json

# Bucket 3.2 -- full embedding cache for all 9,356 fr3_descriptor_table.parquet
# rows (~18MB float32 matrix), same "don't commit large embedding arrays"
# rule as above. Fully regeneratable from the frozen descriptor table +
# the frozen embedding spec (common/embeddings.py); SHA-256/shape recorded
# in fr3_embeddings_manifest.json and fr3_embeddings_provenance.jsonl
# instead. Reuses Bucket 2.3's own caches where possible, so a fresh run
# only re-embeds what isn't already cached there.
data/interim/c2_pu/fr3_embeddings.npz
data/interim/c2_pu/fr3_fresh_embeddings.npz
data/interim/c2_pu/fr3_embed_input.json
data/interim/c2_pu/fr3_embed_report.json

# Bucket 3.3 -- raw fused (495-dim) feature matrix, same "don't commit
# large arrays" rule. Fully regeneratable from fr3_descriptor_table.parquet
# + fr3_embeddings.npz; schema/scalers/validation (all small) are
# committed instead via fr3_fusion_schema.json/fr3_fusion_scalers.json/
# fr3_fusion_validation_report.json.
data/interim/c2_pu/fr3_fused_raw.npz

# Bucket 3.4 -- 5 fold-specific scaled feature caches (~9MB each at
# float32), same "don't commit large arrays" rule. Fully regeneratable
# from fr3_fused_raw.npz + fr3_fusion_scalers.json (both already
# accounted for above); checksums/shape/dtype recorded in
# fr3_feature_cache_manifest.json instead.
data/interim/c2_pu/fr3_fold0_scaled_features.npz
data/interim/c2_pu/fr3_fold1_scaled_features.npz
data/interim/c2_pu/fr3_fold2_scaled_features.npz
data/interim/c2_pu/fr3_fold3_scaled_features.npz
data/interim/c2_pu/fr3_fold4_scaled_features.npz

# Scratch files written by test_fr3_embeddings_acceptance.py's live
# WSL re-embed spot-checks -- regenerated every test run, not a pipeline
# artifact.
data/interim/c2_pu/test_fr3_determinism_a.npz
data/interim/c2_pu/test_fr3_determinism_a_input.json
data/interim/c2_pu/test_fr3_determinism_a_report.json
data/interim/c2_pu/test_fr3_determinism_b.npz
data/interim/c2_pu/test_fr3_determinism_b_input.json
data/interim/c2_pu/test_fr3_determinism_b_report.json
data/interim/c2_pu/test_fr3_reembed_spotcheck.npz
data/interim/c2_pu/test_fr3_reembed_spotcheck_input.json
data/interim/c2_pu/test_fr3_reembed_spotcheck_report.json

# Bucket 2.6 external-control homology audit -- raw EMBOSS needleall
# alignment text (~20MB, all 45,790 external-control x FR1-positive pairs
# in full srspair format). Fully regeneratable from the frozen external
# control + positive pool; the parsed, compact summary
# (ext_control_homology_pairs.csv) is committed instead.
data/interim/c2_pu/ext_control_homology/needleall_output.pair
data/interim/c2_pu/ext_control_homology/external_control.fasta
data/interim/c2_pu/ext_control_homology/positives.fasta

# Bucket 4.1 -- run directories (resolved configs, epoch logs, checkpoints)
# produced by the infrastructure smoke test and any future Bucket 4
# training run. Entirely regeneratable/reproducible from the frozen
# feature cache + a run's own resolved config; checkpoints in particular
# are large binary PyTorch state -- same "don't commit large arrays" rule
# as model weights and embedding caches elsewhere in this project.
data/interim/c2_pu/fr4_infra_smoke_test_runs/

# Bucket 4.2 -- PN baseline run directories (resolved configs, epoch
# logs, PyTorch checkpoints). Same reasoning as the smoke-test runs dir
# above; committed summaries (fr4_pn_baseline_fold*_summary.json) and the
# checkpoint SHA-256 they record are the durable, auditable artifacts.
data/interim/c2_pu/fr4_pn_baseline_runs/

# Bucket 4.3 -- nnPU baseline run directories (resolved configs, epoch
# logs, PyTorch checkpoints). Same reasoning as the PN runs dir above;
# committed summaries (fr4_nnpu_baseline_fold*_summary.json) and the
# checkpoint SHA-256 they record are the durable, auditable artifacts.
data/interim/c2_pu/fr4_nnpu_baseline_runs/
